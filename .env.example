# 在项目根目录复制为 .env，替换为你自己创建的数据库账号。
DATABASE_URL=postgres://questionnaire:change_me@127.0.0.1:5432/questionnaire
LISTEN_ADDR=127.0.0.1:3000
PUBLIC_ORIGIN=http://localhost:3000
# 仅本机 HTTP 开发为 false；HTTPS 部署必须为 true。
COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
# 仅在局域网 HTTP 演示或 TLS 终结反向代理后端时设为 true；公网直连部署保持 false
ALLOW_INSECURE_HTTP=false
# 若经由 Nginx/Vite 等可信反代转发 X-Forwarded-For，设为 true
TRUST_PROXY=false
# 单实例内存每日随机盐盲化 IP 限流（auth 按盲化 IP，提交按盲化 IP + 问卷），不落盘不记录明文 IP
AUTH_REQUESTS_PER_MINUTE=60
SUBMISSIONS_PER_MINUTE=600
RUST_LOG=questionnaire_api=info
