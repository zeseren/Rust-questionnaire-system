    "dsl 1 semantics 1;",
    "// 可读名称只绑定身份，不绑定题目标题或数组位置。",
    "bind question choose = \"00000000-0000-4000-8000-000000000001\";",
    "bind question amount = \"00000000-0000-4000-8000-000000000002\";",
    "bind question detail = \"00000000-0000-4000-8000-000000000003\";",
    "bind question confirm = \"00000000-0000-4000-8000-000000000004\";",
    "bind option yes = \"00000000-0000-4000-8000-000000000101\";",
    "bind variable count = \"00000000-0000-4000-8000-000000002001\";",
    "bind variable broken = \"00000000-0000-4000-8000-000000002002\";",
    "bind node intro = \"00000000-0000-4000-8000-000000001001\";",
    "bind node route = \"00000000-0000-4000-8000-000000001002\";",
    "bind node left = \"00000000-0000-4000-8000-000000001003\";",
    "bind node right = \"00000000-0000-4000-8000-000000001004\";",
    "bind node merge = \"00000000-0000-4000-8000-000000001005\";",
    "bind node finish = \"00000000-0000-4000-8000-000000001006\";",
    "let count: number = answer(amount);",
    "let broken: number = 1 / 0;",
    "validate amount = answer(amount) >= 0;",
    "required confirm = coalesce(count > 0, false);",
    "entry intro;",
    "page intro [choose] -> route;",
    "branch route {",
    "  when selected(choose, yes) -> left;",
    "  else -> right;",
    "}",
    "page left [amount] -> merge;",
    "page right [detail] -> merge;",
    "page merge [confirm] -> finish;",
    "end finish = complete;"
  ],
