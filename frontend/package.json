{
  "name": "questionnaire-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test:regression": "node --test tests/answers.test.mjs tests/logic.test.mjs",
    "format": "prettier --write src vite.config.ts index.html package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src vite.config.ts index.html package.json tsconfig.json .prettierrc.json",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lossless-json": "4.3.0",
    "pinia": "3.0.4",
    "vue": "3.5.42",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  }
}
